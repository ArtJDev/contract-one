<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="con">
        <createTable remarks="Хранение данных о Договоре или ДопСоглашении" tableName="CTRACT_CONTRACT">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CTRACT_CONTRACT"/>
            </column>
            <column name="PARENT_CONTRACT_ID" type="UUID"/>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="TYPE_" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="con">
        <createTable tableName="CTRACT_CONTRACT_CONCLUSION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CTRACT_CONTRACT_CONCLUSION"/>
            </column>
            <column name="CONTRACT_ID" type="UUID"/>
            <column name="PARENT_CONTRACT_CONCLUSION_ID" type="UUID"/>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="TYPE_" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="con">
        <addForeignKeyConstraint baseColumnNames="CONTRACT_ID" baseTableName="CTRACT_CONTRACT_CONCLUSION"
                                 constraintName="FK_CTRACT_CONTRACT_CONCLUSION_ON_CONTRACT" referencedColumnNames="ID"
                                 referencedTableName="CTRACT_CONTRACT"/>
    </changeSet>
    <changeSet id="4" author="con">
        <addForeignKeyConstraint baseColumnNames="PARENT_CONTRACT_CONCLUSION_ID"
                                 baseTableName="CTRACT_CONTRACT_CONCLUSION"
                                 constraintName="FK_CTRACT_CONTRACT_CONCLUSION_ON_PARENT_CONTRACT_CONCLUSION"
                                 referencedColumnNames="ID" referencedTableName="CTRACT_CONTRACT_CONCLUSION"/>
    </changeSet>
    <changeSet id="5" author="con">
        <addForeignKeyConstraint baseColumnNames="PARENT_CONTRACT_ID" baseTableName="CTRACT_CONTRACT"
                                 constraintName="FK_CTRACT_CONTRACT_ON_PARENT_CONTRACT" referencedColumnNames="ID"
                                 referencedTableName="CTRACT_CONTRACT"/>
    </changeSet>
</databaseChangeLog>