<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://contractDetailView.title"
      focusComponent="form">
    <data>
        <instance id="contractDc"
                  class="com.company.contractone.entity.Contract">
            <fetchPlan extends="_base">
                <property name="contractConclusion" fetchPlan="_base"/>
                <property name="parentContract" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="contractDl"/>
        </instance>
        <instance id="contractConclusionDc" class="com.company.contractone.entity.ContractConclusion">
            <loader id="contractConclusionDl"/>
            <fetchPlan extends="_base">
                <property name="contract" fetchPlan="_base"/>
            </fetchPlan>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="contractDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <select id="typeField" property="type"/>
            <comboBox id="base" property="contractConclusion" label="Основание (договор)"/>
            <comboBox id="parent" property="parentContract" label="Родительский проект Договора/ДС"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
