<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://contractConclusionListView.title"
      focusComponent="contractConclusionsDataGrid">
    <data>
        <collection id="contractConclusionsDc"
                    class="com.company.contractone.entity.ContractConclusion"> 
            <fetchPlan   extends="_base"/>
            <loader id="contractConclusionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ctract_ContractConclusion e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    
    <layout>
    
        
        <genericFilter id="genericFilter"
                       dataLoader="contractConclusionsDl">
            <properties include=".*"/>
        </genericFilter>
        
<hbox id="buttonsPanel" classNames="buttons-panel">
<startSlot>

<button id="createButton" action="contractConclusionsDataGrid.createAction"/>

<button id="editButton" action="contractConclusionsDataGrid.editAction"/>

<button id="removeButton" action="contractConclusionsDataGrid.removeAction"/>

</startSlot>
<endSlot>
<simplePagination id="pagination" dataLoader="contractConclusionsDl"/>
</endSlot>
</hbox>
<dataGrid id="contractConclusionsDataGrid"
        width="100%"
        minHeight="20em"
        dataContainer="contractConclusionsDc"
 columnReorderingAllowed="true">
    <actions>
    <action id="createAction" type="list_create"/>
    
    
    <action id="editAction" type="list_edit"/>
    
    
    <action id="removeAction" type="list_remove"/>
    
    
    </actions>
    <columns resizable="true">
    
    
        <column property="name"/>
    
        <column property="createdDate"/>
    
        <column property="type"/>
    
    </columns>
</dataGrid>
        
        <hbox id="lookupActions" visible="false">
        
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
